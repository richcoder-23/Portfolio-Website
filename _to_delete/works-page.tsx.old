import type { Metadata } from "next";
import RansomWord from "@/components/ransom/RansomWord";
import PageFrame from "@/components/works/PageFrame";
import ProjectCard from "@/components/works/ProjectCard";
import styles from "@/components/works/works.module.css";
import { CATEGORIES, projectsIn } from "@/lib/projects";

export const metadata: Metadata = {
  title: "Works · Richard Okelu",
  description: "Coding projects, 3D models and animations, and illustrations.",
};

export default function WorksPage() {
  return (
    <PageFrame>
      <section className={styles.intro} aria-labelledby="works-title">
        <h1 id="works-title" className={styles.titleTag}>
          <RansomWord text="Works" />
        </h1>
        <p className={styles.lead}>
          Things I&apos;ve built, modelled and drawn. Jump to a category, or
          scroll through everything.
        </p>

        <nav aria-label="Categories">
          <ul className={styles.jump}>
            {CATEGORIES.map((c) => (
              <li key={c.id}>
                <a href={`#${c.id}`} className={styles.jumpLink}>
                  <span className={styles.lblFirst}>{c.label[0]}</span>
                  <span className={styles.lblRest}>{c.label.slice(1)}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </section>

      {CATEGORIES.map((c) => {
        const projects = projectsIn(c.id);
        return (
          <section
            key={c.id}
            id={c.id}
            className={styles.category}
            aria-labelledby={`${c.id}-title`}
          >
            <div className={styles.categoryHead}>
              <h2 id={`${c.id}-title`} className={styles.categoryTitle}>
                <span className={styles.lblFirst}>{c.label[0]}</span>
                <span className={styles.lblRest}>{c.label.slice(1)}</span>
              </h2>
              <p className={styles.categoryBlurb}>{c.blurb}</p>
            </div>

            {projects.length > 0 ? (
              <ul className={styles.grid}>
                {projects.map((p) => (
                  <li key={p.slug}>
                    <ProjectCard project={p} />
                  </li>
                ))}
              </ul>
            ) : (
              <p className={styles.empty}>More on the way.</p>
            )}
          </section>
        );
      })}
    </PageFrame>
  );
}